name: Build Custom OPKG Feed (SmartDNS + Passwall)

on:
  push:
    branches: [ main, master ]
  schedule:
    - cron: '18 22 * * *'
  workflow_dispatch:

permissions:
  contents: write
  pages: write

jobs:
  build-feed:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install dependencies and build usign
        run: |
          sudo apt-get update
          sudo apt-get install -y ca-certificates perl python3 gzip wget jq unzip cmake build-essential file
          git config --global http.sslVerify false
          
          git clone https://github.com/openwrt/usign.git /tmp/usign
          cd /tmp/usign && cmake . && make && sudo cp usign /usr/local/bin/

      - name: Download IPKs and Filter Architecture
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          mkdir -p public
          cd public

          download_latest_release() {
            local repo=$1
            echo "Fetching latest release from: $repo"
            
            RELEASE_DATA=$(curl -s -H "Authorization: Bearer $GH_TOKEN" "https://api.github.com/repos/$repo/releases/latest")
            
            # 下载 .ipk 文件
            echo "$RELEASE_DATA" | jq -r '.assets[]? | select(.name != null and (.name | endswith(".ipk"))) | .browser_download_url // empty' | while read -r url; do
              if [[ "$url" =~ ^https?:// ]]; then
                echo "Downloading IPK: $url"
                wget -q -c "$url" || true
              fi
            done

            # 下载 .zip 文件
            echo "$RELEASE_DATA" | jq -r '.assets[]? | select(.name != null and (.name | endswith(".zip"))) | .browser_download_url // empty' | while read -r url; do
              if [[ "$url" =~ ^https?:// ]]; then
                echo "Downloading ZIP archive: $url"
                wget -q -c "$url" -O temp.zip || true
                if [ -f temp.zip ]; then
                  unzip -o -q temp.zip || true
                  rm -f temp.zip
                fi
              fi
            done
          }

          download_latest_release "pymumu/smartdns"
          download_latest_release "Openwrt-Passwall/openwrt-passwall"
          download_latest_release "moetayuko/openwrt-passwall-build"

          # 展平子目录
          find . -mindepth 2 -type f -name "*.ipk" -exec mv {} . \; 2>/dev/null || true

          # ================= 【SmartDNS & Passwall 垃圾包精准清洗】 =================
          
          # 1. 删除非 OpenWrt 系统的 Optware 包和 Lite 简化版界面
          find . -name "*optware*" -type f -delete || true
          find . -name "*smartdns-lite*" -type f -delete || true
          find . -name "*luci-compat*" -type f -delete || true

          # 2. 强行抹除所有非 x86_64 架构（防止 SmartDNS 的 -all.ipk 后缀误导脚本）
          for arch in aarch64 arm mips mipsel riscv i386 x86-openwrt; do
            find . -name "*${arch}*" -type f -delete || true
          done

          # 3. 校验并删除非标准 IPK 压缩包
          for f in *.ipk; do
            [ -e "$f" ] || continue
            if ! file "$f" | grep -E -q "Debian binary package|POSIX tar archive|gzip compressed data"; then
              echo "Removing invalid IPK: $f"
              rm -f "$f"
            fi
          done

          # 4. 剔除非中文语言包与 22.03 旧界面
          find . -name "luci-i18n-*" ! -name "*zh-cn*" -type f -delete || true
          find . -type f -name "*.apk" -delete || true
          find . -type f -name "22.03-*" -delete || true

          # 5. 剥离 23.05-24.10 前缀
          for f in 23.05-24.10_*; do
            if [ -f "$f" ]; then
              mv "$f" "${f#23.05-24.10_}"
            fi
          done
          # =========================================================================

      # ====================================================
      # 👇【新增步骤】自动解包修改 Passwall 的 app.sh 脚本并重包
      # ====================================================
      # ====================================================
      # 👇 自动解包修改 Passwall 的 app.sh 脚本并重包（双层精准探测）
      # ====================================================
      - name: Patch Passwall IPK
        run: |
          cd public
          PASSWALL_IPK=""
          
          # 遍历所有 IPK，拆开第二层的 data.tar.* 寻找 app.sh
          for f in *.ipk; do
            [ -f "$f" ] || continue
            mkdir -p /tmp/check_ipk
            if tar -xf "$f" -C /tmp/check_ipk 2>/dev/null; then
              DATA_ARCH=$(ls /tmp/check_ipk/data.tar.* 2>/dev/null | head -n 1)
              if [ -n "$DATA_ARCH" ]; then
                if tar -tf "$DATA_ARCH" 2>/dev/null | grep -q "passwall/app.sh"; then
                  PASSWALL_IPK="$f"
                  rm -rf /tmp/check_ipk
                  break
                fi
              fi
            fi
            rm -rf /tmp/check_ipk
          done

          if [ -n "$PASSWALL_IPK" ]; then
            echo "精准找到包含 app.sh 的目标 IPK: $PASSWALL_IPK"
            
            mkdir -p /tmp/ipk_extract
            tar -xf "$PASSWALL_IPK" -C /tmp/ipk_extract
            
            cd /tmp/ipk_extract
            DATA_ARCHIVE=$(ls data.tar.* | head -n 1)
            mkdir -p data_content
            tar -xf "$DATA_ARCHIVE" -C data_content
            
            TARGET_FILE=$(find data_content -type f -path "*/passwall/app.sh")
            
            if [ -f "$TARGET_FILE" ]; then
              echo "找到目标文件: $TARGET_FILE ，开始执行修改..."
              
              # 修改 1：将 local RUN_NEW_DNSMASQ=1 改为 0
              sed -i 's/local RUN_NEW_DNSMASQ=1/local RUN_NEW_DNSMASQ=0/g' "$TARGET_FILE"
              
              # 修改 2：给 RUN_NEW_DNSMASQ=${DNS_REDIRECT} 前面加 # 注释
              sed -i 's/RUN_NEW_DNSMASQ=\${DNS_REDIRECT}/# RUN_NEW_DNSMASQ=\${DNS_REDIRECT}/g' "$TARGET_FILE"
              
              echo "文件修改完成，校验修改后的内容："
              grep "RUN_NEW_DNSMASQ" "$TARGET_FILE" || true
            else
              echo "警告：未找到 app.sh 文件！"
            fi
            
            # 保持原格式重新打包 data.tar.*
            cd data_content
            if [[ "$DATA_ARCHIVE" == *.gz ]]; then
              tar -czf "../$DATA_ARCHIVE" .
            elif [[ "$DATA_ARCHIVE" == *.xz ]]; then
              tar -cJf "../$DATA_ARCHIVE" .
            elif [[ "$DATA_ARCHIVE" == *.zst ]]; then
              tar --zstd -cf "../$DATA_ARCHIVE" .
            else
              tar -czf "../$DATA_ARCHIVE" .
            fi
            cd ..
            rm -rf data_content
            
            # 重新打包成最终 IPK
            tar -czf "$GITHUB_WORKSPACE/public/$PASSWALL_IPK" debian-binary control.tar.* "$DATA_ARCHIVE"
            
            cd $GITHUB_WORKSPACE
            rm -rf /tmp/ipk_extract
            echo "Passwall IPK 修改并重新打包完毕！"
          else
            echo "提示：未找到包含 app.sh 的 Passwall IPK 包，请检查下载列表。"
          fi

      - name: Build Index (Perl)
        run: |
          cd public
          
          # 尝试下载 OpenWrt 官方索引脚本
          curl -sSL "https://raw.githubusercontent.com/openwrt/openwrt/v22.03.5/scripts/opkg-make-index.pl" -o opkg-make-index.pl || true

          # 终极校验：确保文件存在、非空，且第一行是以 "#!" 开头的合法脚本
          if [ -s opkg-make-index.pl ] && head -n 1 opkg-make-index.pl | grep -q "^#!"; then
            echo "Successfully fetched opkg-make-index.pl. Building Packages index..."
            chmod +x opkg-make-index.pl
            ./opkg-make-index.pl . > Packages || true
            rm -f opkg-make-index.pl
          else
            echo "opkg-make-index.pl is invalid or 404, skipping Perl indexer."
            rm -f opkg-make-index.pl
          fi

      - name: Fallback Indexer (Python)
        shell: python
        run: |
          import os, tarfile, io, hashlib

          os.chdir('public')
          if os.path.exists('Packages') and os.path.getsize('Packages') > 0:
              print("Packages index created successfully by Perl script.")
          else:
              print("Running Python indexer...")
              entries = []
              for filename in sorted(os.listdir('.')):
                  if not filename.endswith('.ipk'):
                      continue
                  filepath = filename
                  size = os.path.getsize(filepath)
                  with open(filepath, 'rb') as f:
                      content = f.read()
                      md5 = hashlib.md5(content).hexdigest()
                      sha256 = hashlib.sha256(content).hexdigest()
                  control_text = ''
                  try:
                      with tarfile.open(filepath, 'r:*') as outer:
                          for m in outer.getmembers():
                              if 'control.tar' in m.name:
                                  ctrl_bytes = outer.extractfile(m).read()
                                  with tarfile.open(fileobj=io.BytesIO(ctrl_bytes), mode='r:*') as inner:
                                      for im in inner.getmembers():
                                          if im.name in ['./control', 'control']:
                                              control_text = inner.extractfile(im).read().decode('utf-8', errors='ignore').strip()
                                              break
                                  break
                  except Exception as e:
                      print(f'Warning {filename}: {e}')
                      continue
                  if control_text:
                      entry = f"{control_text}\nFilename: ./{filename}\nSize: {size}\nMD5Sum: {md5}\nSHA256sum: {sha256}"
                      entries.append(entry)

              with open('Packages', 'w', encoding='utf-8') as f:
                  f.write('\n\n'.join(entries) + '\n')

      - name: Sanitize Packages Index (Fix Segfault Cause)
        shell: python
        run: |
          import os

          os.chdir('public')
          if not os.path.exists('Packages'):
              print("Error: Packages file missing!")
              exit(1)

          with open('Packages', 'r', encoding='utf-8', errors='ignore') as f:
              lines = f.readlines()

          cleaned = []
          for line in lines:
              line = line.rstrip('\r\n')
              if not line.strip():
                  cleaned.append('')
                  continue
              if ':' in line or line.startswith(' ') or line.startswith('\t'):
                  cleaned.append(line)
              else:
                  cleaned.append(' ' + line)

          with open('Packages', 'w', encoding='utf-8') as f:
              f.write('\n'.join(cleaned) + '\n')
          print("Packages index successfully sanitized for opkg C parser!")

      - name: Compress and Sign Feed Index
        env:
          OPKG_SECRET: ${{ secrets.ISTOREOS_OPKG }}
        run: |
          cd public
          gzip -9 -c Packages > Packages.gz

          if [ -z "$OPKG_SECRET" ]; then
            echo "Error: OPKG_SECRET is empty!"
            exit 1
          fi

          # 【优化点】：直接在系统的 /tmp 目录生成私钥，彻底与 public 发布目录物理隔离
          printf "%s\n" "$OPKG_SECRET" | tr -d '\r' > /tmp/secret.key
          if ! grep -q "untrusted comment" /tmp/secret.key; then
            echo "untrusted comment: secret key" > /tmp/temp.key
            cat /tmp/secret.key >> /tmp/temp.key
            mv /tmp/temp.key /tmp/secret.key
          fi

          # 使用 /tmp/secret.key 完成签名
          usign -S -m Packages -s /tmp/secret.key -x Packages.sig
          
          # 签名完立即抹除
          rm -f /tmp/secret.key

      - name: Deploy to GitHub Pages
        uses: peaceiris/actions-gh-pages@v4
        env:
          GIT_SSL_NO_VERIFY: "true"
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./public
          force_orphan: true
